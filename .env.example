# Copie para .env e preencha. Nunca versione o .env.

# Endereço do Supabase. Local: rode `npm run db:status` e copie "API URL".
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (anon / publishable) do Supabase. Local: copie de `npm run db:status`.
# É pública por design: a segurança vem das regras de acesso (RLS) no banco.
VITE_SUPABASE_ANON_KEY=

# Login com Google (só no Supabase local; na nuvem configure no painel do Supabase).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
